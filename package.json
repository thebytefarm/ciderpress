{
  "name": "ciderpress-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "bundle": "pnpm --filter @ciderpress/oxlint-plugins bundle",
    "typecheck": "turbo run typecheck",
    "clean": "lauf run clean",
    "clean:build": "lauf run clean",
    "clean:npm": "pnpm dlx rimraf --glob '**/node_modules'",
    "clean:all": "pnpm clean:build && pnpm clean:npm",
    "format": "oxfmt",
    "format:fix": "oxfmt --write",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern benchmarks --ignore-pattern examples",
    "lint:fix": "oxlint --fix --ignore-pattern node_modules --ignore-pattern benchmarks --ignore-pattern examples",
    "test": "turbo run test --filter='./packages/*'",
    "check": "turbo run typecheck //#lint //#format",
    "validate": "turbo run typecheck //#lint //#format --ui=stream",
    "changeset": "changeset",
    "version": "changeset version",
    "postversion": "oxfmt --write",
    "prerelease": "turbo run build",
    "release": "changeset publish",
    "docs:dev": "node packages/ciderpress/dist/cli.mjs dev",
    "docs:dev:headless": "node packages/ciderpress/dist/cli.mjs dev --headless",
    "docs:build": "lauf run build",
    "docs:serve": "node packages/ciderpress/dist/cli.mjs serve",
    "docs:generate": "lauf run docs",
    "dev": "turbo run dev --filter='./packages/*' //#docs:dev:headless",
    "stories": "pnpm --filter @ciderpress/cli stories",
    "ladle": "pnpm --filter @ciderpress/ui ladle",
    "examples": "lauf run examples",
    "clean:examples": "pnpm exec rimraf examples/*/.ciderpress",
    "bench": "pnpm --filter benchmarks bench",
    "bench:run": "pnpm --filter benchmarks bench:run",
    "e2e": "pnpm --filter e2e test",
    "e2e:ui": "pnpm --filter e2e test:ui",
    "e2e:update": "pnpm --filter e2e test:update",
    "e2e:install": "pnpm --filter e2e install:browsers",
    "e2e:serve": "tsx e2e/lib/static-server.ts",
    "e2e:setup": "pnpm docs:build && pnpm e2e:serve"
  },
  "dependencies": {
    "ciderpress": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/material-icon-theme": "^1.2.70",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/pixel": "^1.2.2",
    "@iconify-json/pixelarticons": "^1.2.8",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify-json/vscode-icons": "^1.2.73",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.2.0",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "laufen": "^1.3.1",
    "massaman": "catalog:",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "turbo": "^2.10.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
