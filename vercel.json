{
  "buildCommand": "pnpm build && pnpm install --offline && pnpm docs:build",
  "outputDirectory": ".ciderpress/dist",
  "framework": null,
  "installCommand": "pnpm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"changeset-release/main\" ]"
}
