# Argos visual regression service token.
# Get yours at https://app.argos-ci.com after connecting the repo.
# Leave blank to run locally without uploading — screenshots will still be
# captured under .playwright/screenshots/, just not compared against baselines.
ARGOS_TOKEN=

# Override the docs site URL Playwright runs against.
# Defaults to http://localhost:8080 (the port pnpm docs:serve uses).
# BASE_URL=http://localhost:8080

# Set to 1 to skip auto-starting the docs server in playwright.config.ts.
# Useful if you've already got `pnpm docs:dev` running in another terminal.
# SKIP_WEB_SERVER=1
