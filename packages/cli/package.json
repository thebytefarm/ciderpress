{
  "name": "@ciderpress/cli",
  "version": "1.0.0-rc.3",
  "description": "CLI for building and serving ciderpress documentation sites",
  "keywords": [
    "ciderpress",
    "cli",
    "docs",
    "rspress"
  ],
  "homepage": "https://github.com/thebytefarm/ciderpress/tree/main/packages/cli#readme",
  "bugs": "https://github.com/thebytefarm/ciderpress/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebytefarm/ciderpress.git",
    "directory": "packages/cli"
  },
  "bin": {
    "ciderpress": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "kidd build",
    "dev": "kidd dev",
    "stories": "kidd stories",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@ciderpress/config": "workspace:*",
    "@ciderpress/templates": "workspace:*",
    "@ciderpress/theme": "workspace:*",
    "@ciderpress/ui": "workspace:*",
    "@clack/prompts": "^1.5.1",
    "@kidd-cli/core": "^0.24.0",
    "@rspress/core": "catalog:",
    "fast-glob": "^3.3.3",
    "get-port": "^7.2.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.0.5",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "jiti": "^2.7.0",
    "liquidjs": "^10.27.0",
    "massaman": "catalog:",
    "react": "^19.2.7",
    "yaml": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kidd-cli/cli": "^0.11.9",
    "@types/react": "^19.2.17",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
