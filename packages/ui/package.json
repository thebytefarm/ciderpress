{
  "name": "@ciderpress/ui",
  "version": "1.0.0-rc.16",
  "description": "Rspress plugin, theme components, and styles for ciderpress",
  "keywords": [
    "ciderpress",
    "react",
    "rspress",
    "theme",
    "ui"
  ],
  "homepage": "https://github.com/thebytefarm/ciderpress/tree/main/packages/ui#readme",
  "bugs": "https://github.com/thebytefarm/ciderpress/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebytefarm/ciderpress.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/theme"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs"
    },
    "./theme": {
      "types": "./src/theme/index.tsx",
      "import": "./src/theme/index.tsx"
    },
    "./icons": {
      "types": "./src/theme/icons/index.ts",
      "import": "./src/theme/icons/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "postbuild": "node scripts/generate-theme-css.mjs && oxfmt --write src/theme/styles/themes src/head/css/themes && node scripts/minify-head.mjs",
    "dev": "rslib build --watch --no-clean",
    "generate:theme-css": "node scripts/generate-theme-css.mjs",
    "ladle": "ladle serve",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ciderpress/config": "workspace:*",
    "@ciderpress/theme": "workspace:*",
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/material-icon-theme": "^1.2.70",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/pixel": "^1.2.2",
    "@iconify-json/pixelarticons": "^1.2.9",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify-json/vscode-icons": "^1.2.76",
    "@iconify/react": "^6.0.2",
    "@mermaid-js/layout-elk": "^0.2.3",
    "@rspress/plugin-sitemap": "catalog:",
    "clsx": "^2.1.1",
    "massaman": "catalog:",
    "mermaid": "^11.17.2",
    "react-aria-components": "^1.20.0",
    "ts-morph": "^28.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@rslib/core": "catalog:",
    "@rspress/core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rspress-plugin-devkit": "^1.0.0",
    "rspress-plugin-file-tree": "^1.0.5",
    "rspress-plugin-katex": "^1.0.1",
    "rspress-plugin-supersub": "^1.0.0",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@rspress/core": "catalog:",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
